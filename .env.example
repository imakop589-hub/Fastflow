# FoodBrio Multi-Vendor Food Delivery Marketplace
# Phase 1 Environment Configuration

APP_NAME="FoodBrio Marketplace"
APP_ENV=local
APP_KEY=base64:DEMO_GENERATED_KEY_REPLACE_WITH_ARTISAN_KEY
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodbrio_db
DB_USERNAME=foodbrio_user
DB_PASSWORD=secret_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@foodbrio.local"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum Token Expiration
SANCTUM_EXPIRATION=525600

# VITE Frontend Environment
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="http://localhost:8000/api/v1"
